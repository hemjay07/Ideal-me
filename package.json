{
  "name": "idealme-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "IdealMe - Self-evolving AI assistant for productivity and growth",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "npm run build:core",
    "build:core": "npm run build --workspace=@idealme/core",
    "dev:desktop": "npm run build:core && npm run dev --workspace=@idealme/desktop",
    "dev:mobile": "npm run dev --workspace=@idealme/mobile",
    "build": "npm run build --workspaces",
    "build:desktop": "npm run build --workspace=@idealme/desktop",
    "build:mobile": "npm run build --workspace=@idealme/mobile",
    "analyze": "node scripts/analyze.js"
  },
  "keywords": [
    "ai",
    "productivity",
    "self-improvement",
    "assistant"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
